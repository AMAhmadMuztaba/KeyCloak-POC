# Copy this file to .env and fill in REQUIRED values before starting.
# Never commit .env to version control.

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# At least 16 random characters. Example: openssl rand -base64 24
POSTGRES_PASSWORD=

# At least 16 random characters.
KEYCLOAK_ADMIN_PASSWORD=

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KC_REALM=autom-realm
KC_CLIENT_ID=autom-app

# Comma-separated list of allowed CORS origins for the backend API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google SSO — create OAuth 2.0 credentials at console.cloud.google.com
# Redirect URI: http://localhost:8080/realms/app-realm/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft SSO — register an app at portal.azure.com > App registrations
# Redirect URI: http://localhost:8080/realms/app-realm/broker/microsoft/endpoint
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
